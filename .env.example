# Copy this file to .env and fill in real values. Never commit .env.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only (API, scripts). Bypasses Row Level Security: never put it in web/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Seconds before a Supabase call gives up (scoring still succeeds)
STORAGE_TIMEOUT_S=5

# Demo analyst account (create it in the Supabase dashboard); used by integration tests
DEMO_ANALYST_EMAIL=analyst@example.com
DEMO_ANALYST_PASSWORD=your-demo-password

# FastAPI service URL (used by the simulator and dashboard)
API_URL=http://localhost:8000

# Browser origins allowed to call the API (comma-separated). Default: the dashboard dev server.
CORS_ORIGINS=http://localhost:5180

# POST /demo/stream: rows replayed server-side, speed, size, and limits
DEMO_ROWS_PATH=api/assets/demo_rows.csv.gz
DEMO_RATE_PER_S=10
DEMO_MAX_ROWS=200
DEMO_COOLDOWN_S=60
DEMO_MAX_PER_HOUR=12

# Port the API listens on in Docker (Render sets this itself)
PORT=8000

# Trained model artifact loaded by the API
MODEL_PATH=ml/artifacts/model.joblib
METADATA_PATH=ml/artifacts/metadata.json

# API risk bands and limits (HIGH threshold comes from metadata.json)
MEDIUM_THRESHOLD=0.05
MAX_BATCH_SIZE=1000
LOG_LEVEL=INFO
