# Copy this file to .env and fill in real values. Never commit .env.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FastAPI service URL (used by the simulator and dashboard)
API_URL=http://localhost:8000

# Trained model artifact loaded by the API
MODEL_PATH=ml/artifacts/model.joblib
METADATA_PATH=ml/artifacts/metadata.json

# API risk bands and limits (HIGH threshold comes from metadata.json)
MEDIUM_THRESHOLD=0.05
MAX_BATCH_SIZE=1000
LOG_LEVEL=INFO
