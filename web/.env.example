# Copy to web/.env and fill in. Everything prefixed VITE_ is bundled into the
# browser and visible to anyone: only PUBLIC values belong here.
# NEVER put the Supabase secret / service-role key in this file.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# FastAPI service (uvicorn api.main:app)
VITE_API_URL=http://localhost:8000
